{
  "name": "carbon-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Service B: mesin perhitungan jejak karbon EcoChain",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev-token": "tsx scripts/dev-token.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
